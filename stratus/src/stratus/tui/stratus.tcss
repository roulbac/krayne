/* stratus — k9s-inspired dark theme */

Screen {
    background: #0b1020;
    color: #e5e7eb;
}

/* ── main screen ─────────────────────────────── */

#header {
    height: 7;
    padding: 0 1;
    background: #0b1020;
}

#title-bar {
    height: 1;
    content-align: center middle;
    text-align: center;
    background: #111832;
    color: #e5e7eb;
}

#prompt {
    height: 3;
    margin: 0 1;
    border: round #38bdf8;
    background: #0b1020;
    border-title-color: #38bdf8;
    border-title-style: bold;
}

#prompt.command {
    border: round #f59e0b;
    border-title-color: #f59e0b;
}

#table {
    height: 1fr;
    margin: 0 1;
    border: round #1f2a4d;
    background: #0b1020;
    scrollbar-size-vertical: 1;
}

#table > .datatable--header {
    background: #0b1020;
    color: #f59e0b;
    text-style: bold;
}

#table > .datatable--cursor {
    background: #1e3a8a;
    color: #ffffff;
}

#table > .datatable--hover {
    background: #16204a;
}

#empty {
    height: auto;
    margin: 0 2;
    padding: 1 2;
    text-align: center;
    display: none;
}

#crumbs {
    height: 1;
    padding: 0 1;
    background: #0b1020;
}

/* ── detail & logs ───────────────────────────── */

#detail-title, #log-title, #form-title, #editor-title {
    height: 1;
    padding: 0 1;
    background: #111832;
}

#detail-scroll {
    padding: 1 2;
}

#log {
    height: 1fr;
    border: round #1f2a4d;
    margin: 0 1;
    background: #05070f;
    scrollbar-size-vertical: 1;
}

/* ── forms ───────────────────────────────────── */

#form-body {
    height: 1fr;
}

#form-fields {
    width: 3fr;
    padding: 0 2;
    border-right: tall #1f2a4d;
    scrollbar-size-vertical: 1;
}

#form-preview {
    width: 2fr;
    padding: 0 1;
}

.form-section {
    margin-top: 1;
    color: #f59e0b;
}

.field-label {
    margin-top: 1;
    color: #cbd5e1;
}

.field-row {
    height: 1;
    margin-top: 1;
}

.field-name {
    width: 28;
    color: #cbd5e1;
}

.field-row Input, .field-row Select {
    width: 1fr;
    background: #16204a;
}

.field-row Input:focus, .field-row Select:focus {
    background: #1e3a8a;
}

.field-row Switch {
    height: 1;
    border: none;
    padding: 0;
    width: 8;
}

.field-help {
    color: #64748b;
    height: auto;
    padding-left: 28;
}

.field-error {
    color: #f87171;
    height: auto;
    padding-left: 28;
    display: none;
}

.field-area {
    height: 5;
    border: tall #1f2a4d;
}

.field-area:focus {
    border: tall #38bdf8;
}

.switch-row {
    height: 3;
    margin-top: 1;
}

.switch-row Label {
    padding: 1 1;
}

#form-buttons {
    height: 3;
    padding: 0 1;
    background: #111832;
}

#form-buttons Button {
    margin-right: 1;
}

/* ── editor ──────────────────────────────────── */

#editor {
    height: 1fr;
    margin: 0 1;
}

#editor-status {
    height: 1;
    padding: 0 1;
}

/* ── dialogs ─────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: rgba(5, 7, 15, 0.7);
}

.dialog {
    width: 72;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round #38bdf8;
    background: #111832;
}

.dialog.danger {
    border: round #f87171;
}

.dialog-title {
    margin-bottom: 1;
}

.dialog-body {
    margin-bottom: 1;
}

.dialog-buttons {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-left: 1;
}

.dialog OptionList {
    height: auto;
    max-height: 12;
    background: #0b1020;
}

.help-box {
    width: 100;
    max-width: 95%;
    height: 90%;
    padding: 1 2;
    border: round #f59e0b;
    background: #111832;
}
